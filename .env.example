# poof environment variables
#
# Copy to .env.local for local dev (`.env*` is gitignored, this file is the
# committed exception). Full var list derived from:
#   grep -rhoE "process\.env\.[A-Z0-9_]+" agent convex | sort -u
# plus the `TRADING_*` limit overrides read in agent/lib/state.ts (resolveLimits).

# --- SAFETY SWITCHES (control real-money trading) ---
DRY_RUN=true                # default ON (agent/lib/state.ts isDryRun). "false" = place REAL orders. This is the kill switch.
TRADING212_ENV=demo         # "demo" (paper) or "live" (real money). Defaults to "demo" everywhere it's read.
REQUIRE_APPROVAL=false      # "true" = require Slack approval before a real order (only enforced when DRY_RUN=false, see agent/tools/submit_orders.ts)

# --- BROKER (Trading 212) ---
TRADING212_API_KEY=your-t212-api-key-here
# Either name works for the secret (agent/lib/t212.ts accepts both; set only one):
TRADING212_API_SECRET=your-t212-api-secret-here
# TRADING212_SECRET_KEY=your-t212-api-secret-here

# --- MODEL ---
# The orchestrator model is set in code (agent/agent.ts: anthropic/claude-opus-4.8),
# not via env var. Model auth goes through the Vercel AI Gateway via OIDC, handled
# automatically on Vercel deployments and by `vercel env pull` for local dev
# (VERCEL_OIDC_TOKEN). No app-level API key env var was found in agent/convex for this.

# --- MARKET DATA & RESEARCH ---
FINNHUB_API_KEY=your-finnhub-api-key-here   # news + prices (agent/lib/data.ts)
EXA_API_KEY=your-exa-api-key-here           # exa_search web research (agent/lib/exa.ts)
USD_GBP_RATE=0.79                           # optional FX override; falls back to ~0.79 if unset/invalid (agent/lib/state.ts fxRateFromEnv)

# --- MEMORY (Convex) ---
CONVEX_URL=https://your-deployment.convex.cloud

# --- SLACK ---
SLACK_CHANNEL_ID=C0000000000                    # channel the daily cycle report posts to
SLACK_ALERT_WEBHOOK_URL=            # paste your Slack incoming-webhook URL here; used for failure alerts (agent/hooks/alert-on-failure.ts)

# --- ROUTE AUTH (HTTP basic auth fallback for the eve channel) ---
ROUTE_AUTH_BASIC_USERNAME=operator          # defaults to "operator" if unset
ROUTE_AUTH_BASIC_PASSWORD=            # set a strong password here; defaults to a random UUID if unset (no accidental open door, but you can't log in either)

# --- LIMIT OVERRIDES (tune risk-gate aggression; unset/blank/non-numeric falls back to the shipped default) ---
TRADING_MAX_PER_NAME_PCT=0.3                # default 0.3 (30% of equity max in any single name)
TRADING_MAX_DEPLOYED_PCT=1.0                # default 1.0 (100% of equity may be deployed, no idle-cash reserve)
TRADING_MAX_NEW_POSITIONS_PER_DAY=6         # default 6
TRADING_MIN_TRADE_PCT=0.02                  # default 0.02 (2% of equity floor per trade)
TRADING_MAX_TRADE_PCT=0.3                   # default 0.3 (30% of equity ceiling per trade)
TRADING_DAILY_LOSS_HALT_PCT=0.04            # default 0.04 (4% daily loss circuit breaker)
TRADING_MAX_CONCURRENT_POSITIONS=10         # default 10
TRADING_MIN_PRICE=5                         # default 5 (USD minimum share price)
TRADING_MAX_DRAWDOWN_PCT=0.1                # default 0.1 (10% drawdown circuit breaker)
TRADING_MAX_CONSECUTIVE_LOSS_DAYS=2         # default 2
TRADING_LOSS_DAY_MIN_DROP_PCT=0.015          # min day-over-day drop (fraction) that counts as a "loss day" for the consecutive-loss-days breaker; smaller moves are noise
