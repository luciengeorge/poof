# poof environment variables
#
# Copy to .env.local for local dev (`.env*` is gitignored, this file is the
# committed exception). Full var list derived from:
#   grep -rhoE "process\.env\.[A-Z0-9_]+" agent convex | sort -u
# plus the `TRADING_*` limit overrides read in agent/lib/state.ts (resolveLimits).

# --- SAFETY SWITCHES (control real-money trading) ---
DRY_RUN=true                # default ON (agent/lib/state.ts isDryRun). "false" = place REAL orders. This is the kill switch.
TRADING212_ENV=demo         # "demo" (paper) or "live" (real money). Defaults to "demo" everywhere it's read.
REQUIRE_APPROVAL=false      # "true" = require Slack approval before a real order (only enforced when DRY_RUN=false, see agent/tools/submit_orders.ts)

# --- BROKER (Trading 212) ---
TRADING212_API_KEY=your-t212-api-key-here
# Either name works for the secret (agent/lib/t212.ts accepts both; set only one):
TRADING212_API_SECRET=your-t212-api-secret-here
# TRADING212_SECRET_KEY=your-t212-api-secret-here

# --- MODEL ---
# The orchestrator model is set in code (agent/agent.ts: anthropic/claude-opus-4.8),
# not via env var. Model auth goes through the Vercel AI Gateway via OIDC, handled
# automatically on Vercel deployments and by `vercel env pull` for local dev
# (VERCEL_OIDC_TOKEN). No app-level API key env var was found in agent/convex for this.

# --- MARKET DATA & RESEARCH ---
FINNHUB_API_KEY=your-finnhub-api-key-here   # news + prices (agent/lib/data.ts)
EXA_API_KEY=your-exa-api-key-here           # exa_search web research (agent/lib/exa.ts)
TIINGO_API_KEY=your-tiingo-api-key-here     # daily candles (agent/lib/tiingo.ts): the funnel's outcome scorer in production (agent/lib/funnel-schedule.ts) and the local backtest harness. Without it the scorer skips and logs. Not used by the live trading cycle or CI evals.
USD_GBP_RATE=0.79                           # optional FX override; falls back to ~0.79 if unset/invalid (agent/lib/state.ts fxRateFromEnv)

# --- MEMORY (Convex) ---
CONVEX_URL=https://your-deployment.convex.cloud

# --- SLACK ---
SLACK_CHANNEL_ID=C0000000000                    # channel the daily cycle report posts to
SLACK_ALERT_WEBHOOK_URL=            # paste your Slack incoming-webhook URL here; used for failure alerts (agent/hooks/alert-on-failure.ts)

# --- ROUTE AUTH (HTTP basic auth fallback for the eve channel) ---
ROUTE_AUTH_BASIC_USERNAME=operator          # defaults to "operator" if unset
ROUTE_AUTH_BASIC_PASSWORD=            # set a strong password here; defaults to a random UUID if unset (no accidental open door, but you can't log in either)

# --- LIMIT OVERRIDES (optional; every line below is COMMENTED OUT on purpose) ---
# An unset, blank or non-numeric TRADING_* var falls back to the value shipped in
# DEFAULT_LIMITS (agent/lib/risk.ts), which is the gate as tuned in #76. Leaving these
# commented is therefore the correct configuration for any deployment that has not
# deliberately chosen to differ. They are shown, rather than omitted, so an operator can
# see what is tunable and what the live setting is.
#
# The danger this guards against: an earlier version of this file shipped these as LIVE
# assignments holding the PRE-#76 values (2% trade floor, 10 concurrent positions). Copying
# it, as the README tells you to, silently restored the five-pound-probe sizing that #76
# existed to eliminate, on an account trading real money. Uncomment a line only when you
# mean to override that deployment's risk gate.
#
# The values below ARE the shipped defaults. agent/lib/env-example.test.ts fails the build
# if they ever drift from DEFAULT_LIMITS again.
# TRADING_MAX_PER_NAME_PCT=0.3               # ceiling on any single name, as a fraction of equity
# TRADING_MAX_DEPLOYED_PCT=0.9               # ceiling on the stock sleeve, as a fraction of equity; the rest sits in the index core
# TRADING_MAX_NEW_POSITIONS_PER_DAY=4        # new positions that may be opened in one day
# TRADING_MIN_TRADE_PCT=0.15                 # floor per trade; a smaller order is REJECTED, not placed
# TRADING_MAX_TRADE_PCT=0.3                  # ceiling per trade
# TRADING_DAILY_LOSS_HALT_PCT=0.06           # daily loss circuit breaker; resumes on its own the next day
# TRADING_MAX_CONCURRENT_POSITIONS=4         # open stock positions at once; the index core does not count
# TRADING_MIN_PRICE=5                        # minimum share price, USD
# TRADING_MAX_DRAWDOWN_PCT=0.15              # drawdown circuit breaker; requires a manual resume
# TRADING_MAX_CONSECUTIVE_LOSS_DAYS=2        # consecutive loss days before the breaker trips
# TRADING_LOSS_DAY_MIN_DROP_PCT=0.015        # min day-over-day drop counting as a "loss day"; smaller moves are noise. Default lives in agent/lib/state.ts, not DEFAULT_LIMITS
